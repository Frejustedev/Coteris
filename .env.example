# =============================================================================
# Coteris — configuration
#
# Copiez ce fichier vers .env et complétez les valeurs.
# .env n'est JAMAIS commité. Aucun secret réel ne doit figurer dans ce fichier-ci.
#
# Toutes ces variables sont validées au démarrage par packages/shared/src/env.ts.
# L'application refuse de démarrer si une variable requise manque ou est invalide,
# plutôt que d'échouer plus tard de façon obscure.
# =============================================================================

# --- Général -----------------------------------------------------------------
NODE_ENV=development
APP_URL=http://localhost:3000
LOG_LEVEL=debug

# --- Base de données ---------------------------------------------------------
# PostgreSQL 16 ou supérieur.
DATABASE_URL=postgresql://coteris:coteris@localhost:5432/coteris

# Pool de connexions. Le worker utilise son propre pool (voir WORKER_POOL_SIZE).
DATABASE_POOL_SIZE=10

# --- Authentification --------------------------------------------------------
# Secret de signature des sessions. Générez-en un avec :
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=remplacez-moi-par-un-secret-de-32-octets-minimum

# --- Journal d'audit ---------------------------------------------------------
# Clé HMAC de la chaîne d'audit. La modifier invalide la vérification de toutes
# les chaînes existantes : ne la changez jamais sur une base en production.
AUDIT_HASH_SECRET=remplacez-moi-par-un-secret-distinct-du-precedent

# --- Stockage des fichiers ---------------------------------------------------
# local : disque du serveur (développement, hébergement mutualisé)
# s3    : tout stockage objet compatible S3 (MinIO, Cloudflare R2, Scaleway)
STORAGE_DRIVER=local

# Requis si STORAGE_DRIVER=local. Doit être hors de tout répertoire servi
# publiquement par le serveur web.
STORAGE_LOCAL_PATH=./.data/storage

# Requis si STORAGE_DRIVER=s3
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=coteris
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=true

# Durée de validité des URL signées servant les copies, en secondes.
STORAGE_SIGNED_URL_TTL=300

# --- Courriel ----------------------------------------------------------------
# smtp | resend | console (console : affiche le message, n'envoie rien)
MAIL_DRIVER=console
MAIL_FROM="Coteris <no-reply@coteris.local>"

# Requis si MAIL_DRIVER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false

# Requis si MAIL_DRIVER=resend
RESEND_API_KEY=

# --- Intelligence artificielle -----------------------------------------------
# mock : implémentation simulée déterministe, aucun appel réseau, aucun coût.
#        C'est le défaut, et c'est ce qu'utilisent tous les tests.
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=

OCR_PROVIDER=mock
OCR_API_KEY=
OCR_MODEL=

# Version du jeu de prompts. Enregistrée dans ai_runs pour rendre toute
# proposition de note reproductible. À incrémenter à chaque modification
# d'un prompt d'analyse.
AI_PROMPT_VERSION=1

# --- Coûts et quotas ---------------------------------------------------------
# Coupe-circuit : plafond de dépense par organisation et par mois, en euros.
# Vérifié AVANT chaque appel, jamais après.
AI_MONTHLY_BUDGET_EUR=50

# Interrompt tout traitement si le coût d'une seule épreuve dépasse ce montant.
AI_PER_ASSESSMENT_BUDGET_EUR=10

# --- Seuils de confiance -----------------------------------------------------
# Bornes en pourcentage. Configurables par organisation en base ; ces valeurs
# ne servent que de défaut à l'initialisation.
CONFIDENCE_GREEN_MIN=90
CONFIDENCE_ORANGE_MIN=65

# Proportion de cas verts renvoyés en seconde vérification, pour contrôle
# qualité. 0 désactive l'échantillonnage.
SECOND_PASS_GREEN_SAMPLE_RATE=0.05

# --- Worker ------------------------------------------------------------------
WORKER_CONCURRENCY=4
WORKER_POOL_SIZE=5

# --- Limites d'import --------------------------------------------------------
UPLOAD_MAX_FILE_SIZE_MB=25
UPLOAD_MAX_PAGES_PER_SUBMISSION=20
UPLOAD_MIN_DPI=150
