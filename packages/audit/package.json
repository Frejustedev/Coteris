{
  "name": "@coteris/audit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc --build",
    "clean": "rimraf dist .turbo *.tsbuildinfo",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "verify": "tsx src/cli/verify.ts"
  },
  "dependencies": {
    "@coteris/database": "workspace:*",
    "@coteris/shared": "workspace:*",
    "drizzle-orm": "^0.38.3"
  },
  "devDependencies": {
    "postgres": "^3.4.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
